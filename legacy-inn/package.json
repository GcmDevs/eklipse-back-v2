{
  "name": "eklipse-gcm-backend-inn",
  "version": "4.0.0",
  "description": "Eklipse GCM Backend (Inventario)",
  "author": "ejdao",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"**/*.ts\" \"**/*.js\" \"**/*.json\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config apps/eklipse-gcm-backend/test/jest-e2e.json",
    "typeorm": "node --require ts-node/register --require tsconfig-paths/register ../node_modules/typeorm/cli.js",
    "migration:generate": "cross-env-shell npm run typeorm -- migration:generate ./database/migrations/$npm_config_name -d ./src/typeorm.config.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./src/typeorm.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/typeorm.config.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "puppeteer": "^24.36.1"
  }
}
