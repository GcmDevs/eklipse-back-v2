{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@inn/*": ["src/*"],
      "@inn/ctc/*": ["src/ctc/*"],
      "@inn/central-compras/*": ["src/central-compras/*"],
      "@inn/documentos/*": ["src/documentos/*"],
      "@authorities/*": ["./@authorities/*"],
      "@auth/*": ["./@auth/*"],
      "@common/*": ["./@common/*"],
      "@gtypes/*": ["./@gtypes/*"],
      "@gtypes": ["./@gtypes"],
      "@ctypes/*": ["@types/*"],
      "@ctypes": ["@types"],
      "@orm/*": ["@orm/*"],
      "@orm": ["@orm"],
      "@env": ["../env"],
      "@local": ["@orm"],
      "@local/*": ["@local/*"],
      /* MODULOS VIEJOS */
      "@recursos/*": ["apps/recursos/*"],
      "@activos-fijos/*": ["apps/activos-fijos/*"],
      "@farmacia/*": ["apps/farmacia/*"],
      "@documentos/*": ["apps/documentos/*"],
      "@equipos/*": ["apps/equipos/*"],
      "@core/*": ["apps/core/*"],
      "@vehiculos": ["apps/vehiculos"],
      "@vehiculos/*": ["apps/vehiculos/*"],
      "@productos/*": ["apps/productos/*"],
      "@inn/ek-types": ["inn/@ek-types"],
      "@inn/ek-types/*": ["inn/@ek-types/*"],
      "@inn/orm": ["inn/@orm"],
      "@inn/orm/*": ["inn/@orm/*"],
      "@inn/farmacia/*": ["inn/apps/farmacia/*"],
      "@inn/cruds/*": ["inn/cruds/*"],
      "@inn/ciclico/*": ["inn/apps/inn-ciclico/*"],
      "@inn/old/common/*": ["inn/older-apps/common/*"],
      "@inn/old/orm/*": ["inn/older-apps/projects/orm/*"],
      "@inn/old/authorities/*": ["inn/older-apps/authorities/*"],
      "@inn/rft/*": ["inn/older-apps/projects/older-projects/*"],
      "@inn/old/ekl/*": ["inn/older-apps/projects/eklipse/src/*"],
      "@inn/hpn/*": ["inn/older-apps/apps/hospitalizacion/src/*"],
      "@inn/old/inn/*": ["inn/older-apps/projects/inventario/src/*"],
      "@inn/old/hpn/*": ["inn/older-apps/projects/hospitalizacion/src/*"],
      "@inn/docs/sumpac/*": ["inn/original-apps/documentos/src/suministros-pacientes/*"],
      "@inn/pdts/rct/*": ["inn/original-apps/productos/src/recepciones-tecnicas/*"],
      "@inn/ctc/ctpfb/*": ["inn/original-apps/cotizaciones-prefabricadas/*"]
    }
  }
}
