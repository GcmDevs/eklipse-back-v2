{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@env": ["../env"],
      "@rsa/*": ["../rsa/*"],
      "@common/*": ["../@common/*"],
      "@inn/authorities": ["./authorities"],
      "@inn/types/*": ["./@types/*"],
      "@inn/orm/*": ["./@orm/*"],
      "@inn/*": ["./src/*"],
      // Central de compras (lgc)
      "@inn/lgc/ctc/*": ["./legacy/central-compras/*"],
      "@inn/lgc/ctc/types/*": ["./legacy/central-compras/@types/*"],
      "@inn/lgc/ctc/types": ["./legacy/central-compras/@types"],
      "@inn/lgc/ctc/orm/*": ["./legacy/central-compras/@orm/*"],
      "@inn/lgc/ctc/orm": ["./legacy/central-compras/@orm"],
      // Activos fijos (lgc)
      "@inn/lgc/afn/*": ["./legacy/activos-fijos/*"],
      "@inn/lgc/afn/types/*": ["./legacy/activos-fijos/@types/*"],
      "@inn/lgc/afn/types": ["./legacy/activos-fijos/@types"],
      "@inn/lgc/afn/orm/*": ["./legacy/activos-fijos/@orm/*"],
      "@inn/lgc/afn/orm": ["./legacy/activos-fijos/@orm"],
      // Recepciones tecnicas (lgc)
      "@inn/lgc/rct/*": ["./legacy/recepciones-tecnicas/*"],
      "@inn/lgc/rct/types/*": ["./legacy/recepciones-tecnicas/@types/*"],
      "@inn/lgc/rct/types": ["./legacy/recepciones-tecnicas/@types"],
      "@inn/lgc/rct/orm/*": ["./legacy/recepciones-tecnicas/@orm/*"],
      "@inn/lgc/rct/orm": ["./legacy/recepciones-tecnicas/@orm"]
    }
  },
  "include": [
    "src/**/*",
    "legacy/**/*",
    "@common/**/*",
    "@types/**/*",
    "@orm/**/*",
    "authorities/**/*",
    "../@common/**/*"
  ],
  "exclude": ["node_modules", "dist", "test", "ignored", "**/*spec.ts"]
}
