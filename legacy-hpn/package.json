{
  "name": "eklipse-gcm-backend-hpn",
  "version": "4.0.0",
  "description": "Eklipse GCM Backend (Hospitalizaci\u00f3n)",
  "author": "ejdao",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node init && nest build",
    "format": "prettier --write \"**/*.ts\" \"**/*.js\" \"**/*.json\"",
    "start": "node init && nest start",
    "start:dev": "node init && nest start --watch",
    "start:debug": "node init && nest start --debug --watch",
    "start:prod": "node init && node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config apps/eklipse-gcm-backend/test/jest-e2e.json"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@common/(.*)$": "<rootDir>/../@common/$1",
      "^@env$": "<rootDir>/../env",
      "^@ctypes$": "<rootDir>/@types",
      "^@ctypes/(.*)$": "<rootDir>/@types/$1",
      "^@orm/(.*)$": "<rootDir>/@orm/$1",
      "^@boleta-quirurgica/(.*)$": "<rootDir>/apps/boleta-quirurgica/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
