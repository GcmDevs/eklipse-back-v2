{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@env": ["../env"],
      "@rsa/*": ["../rsa/*"],
      "@common/*": ["../@common/*"],
      "@authorities": ["./authorities"],
      "@ctypes/*": ["./@types/*"],
      "@orm/*": ["./@orm/*"],
      "@hpn/*": ["./src/*"],
      // Traslados asistenciales (lgc)
      "@hpn/lgc/tas/*": ["./legacy/traslados-asistenciales/*"],
      "@hpn/lgc/tas/types/*": ["./legacy/traslados-asistenciales/@types/*"],
      "@hpn/lgc/tas/types": ["./legacy/traslados-asistenciales/@types"],
      "@hpn/lgc/tas/orm/*": ["./legacy/traslados-asistenciales/@orm/*"],
      "@hpn/lgc/tas/orm": ["./legacy/traslados-asistenciales/@orm"],
      // Auditoria (lgc)
      "@hpn/lgc/aud/*": ["./legacy/auditoria/*"],
      "@hpn/lgc/aud/types/*": ["./legacy/auditoria/@types/*"],
      "@hpn/lgc/aud/types": ["./legacy/auditoria/@types"],
      "@hpn/lgc/aud/orm/*": ["./legacy/auditoria/@orm/*"],
      "@hpn/lgc/aud/orm": ["./legacy/auditoria/@orm"]
    }
  },
  "include": [
    "src/**/*",
    "legacy/**/*",
    "@common/**/*",
    "@types/**/*",
    "@orm/**/*",
    "authorities/**/*",
    "../@common/**/*"
  ]
}
