{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@gen/*": ["src/*"],
      "@authorities/*": ["./@authorities/*"],
      "@common/*": ["./@common/*"],
      "@gtypes/*": ["./@gtypes/*"],
      "@gtypes": ["./@gtypes"],
      "@ctypes/*": ["@types/*"],
      "@ctypes": ["@types"],
      "@orm/*": ["@orm/*"],
      "@orm": ["@orm"],
      "@env": ["../env"],
      /* HCN */
      "@hcn/ori/epi/*": ["hcn/original-apps/epicrisis/*"],
      "@hcn/ori/intc/*": ["hcn/original-apps/interconsultas/*"],
      "@hcn/rft/*": ["hcn/older-apps/projects/older-projects/*"],
      "@hcn/old/common/*": ["hcn/older-apps/common/*"],
      /* CRN */
      "@crn/rad/*": ["crn/radicacion/*"],
      "@crn/old/common/*": ["crn/older-apps/common/*"],
      "@crn/old/authorities/*": ["crn/older-apps/authorities/*"],
      "@crn/rft/*": ["crn/older-apps/projects/older-projects/*"],
      "@crn/old/hpn/*": ["crn/older-apps/projects/hospitalizacion/src/*"],
      "@crn/old/inn/*": ["crn/older-apps/projects/inventario/src/*"],
      "@crn/old/ekl/*": ["crn/older-apps/projects/eklipse/src/*"],
      "@crn/old/orm/*": ["crn/older-apps/projects/orm/*"],
      /* SLN */
      "@sln/informes-gerenciales/*": ["sln/app2/informes-gerenciales/*"],
      "@sln/c-types": ["sln/@c-types"],
      "@sln/c-types/*": ["sln/@c-types/*"],
      "@sln/orm": ["sln/@orm"],
      "@sln/orm/*": ["sln/@orm/*"],
      "@sln/info-geren/*": ["sln/apps/informes-gerenciales/src/*"],
      "@sln/pfgp/*": ["sln/apps/estadistico-pfgp/src/*"],
      "@sln/old/common/*": ["sln/older-apps/common/*"],
      "@sln/old/authorities/*": ["sln/older-apps/authorities/*"],
      "@sln/rft/*": ["sln/older-apps/projects/older-projects/*"],
      "@sln/old/hpn/*": ["sln/older-apps/projects/hospitalizacion/src/*"],
      "@sln/old/inn/*": ["sln/older-apps/projects/inventario/src/*"],
      "@sln/old/ekl/*": ["sln/older-apps/projects/eklipse/src/*"],
      "@sln/old/orm/*": ["sln/older-apps/projects/orm/*"]
    }
  }
}
